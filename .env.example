IMAGE=ghcr.io/mirivlad/mymine
LANDING_IMAGE=ghcr.io/mirivlad/mymine-landing
IMAGE_TAG=0.4.4

CONTAINER_NAME=mymine
DATA_DIR=/srv/mymine/data
MC_PORT=25565
MC_ADDRESS=mc.example.org:25565
MC_VERSION=26.2
MAP_URL=/map/
MAP_PORT=44447
BLUEMAP_ACCEPT_DOWNLOAD=false
BLUEMAP_RENDER_THREADS=1
BLUEMAP_METRICS=false
BLUEMAP_UID=1000
BLUEMAP_GID=1000

AUTH_CONTAINER_NAME=mymine-auth
AUTH_DATA_DIR=/srv/mymine/auth-data
AUTH_PORT=25585
AUTH_DOMAIN=auth.example.org
AUTH_BASE_URL=https://auth.example.org
AUTH_INSTANCE_NAME=MyMine
# Required: choose the username that will become the initial Drasl administrator.
DRASL_ADMIN=
# true (default): registration requires proving ownership of an existing Minecraft profile.
# false: MyMine does not verify ownership; the server operator is responsible for access policy/compliance.
VERIFY_MINECRAFT_OWNERSHIP=true
# Safe bootstrap default. On an empty database Drasl prints the initial invite URL to its logs.
DRASL_REQUIRE_INVITE=true
AUTH_MEMORY_LIMIT=384m

LANDING_CONTAINER_NAME=mymine-landing
LANDING_PORT=8080
LANDING_MEMORY_LIMIT=128m
WEB_BIND_ADDR=127.0.0.1
HMCL_VERSION=3.16.3
# showcase, adventure (default), atlas, modern, terminal, classic
LANDING_TEMPLATE=adventure
# Optional custom images for showcase. Put files into LANDING_ASSETS_DIR and use /custom/... URLs.
LANDING_ASSETS_DIR=/srv/mymine/landing-assets
LANDING_HERO_IMAGE=/assets/voxel-world.webp
LANDING_GALLERY_IMAGE_1=/assets/isometric-world.webp
LANDING_GALLERY_IMAGE_2=/assets/bluemap.webp
LANDING_GALLERY_IMAGE_3=/assets/voxel-world.webp

TZ=UTC
MEMORY=4G
CONTAINER_MEMORY_LIMIT=6g
SERVER_NAME=MyMine
MOTD=MyMine Fabric 26.2
MODE=survival
DIFFICULTY=normal
MAX_PLAYERS=20
ENABLE_WHITELIST=false
ENFORCE_WHITELIST=false
PVP=true
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
SPAWN_PROTECTION=0
ENABLE_COMMAND_BLOCK=false
ALLOW_FLIGHT=true
ENABLE_RCON=false
