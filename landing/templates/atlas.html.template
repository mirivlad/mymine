<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#e8e4d7"><title>${SERVER_NAME} — Minecraft ${MC_VERSION}</title>
<style>
:root{--paper:#e8e4d7;--ink:#18211b;--muted:#617068;--forest:#234d35;--lime:#8acb56;--line:#bdc4b9;--card:#f4f1e7}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;overflow-x:hidden;background:var(--paper);color:var(--ink);font:16px/1.55 Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background-image:linear-gradient(rgba(24,33,27,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(24,33,27,.035) 1px,transparent 1px);background-size:28px 28px}a{color:inherit}.wrap{width:min(1180px,calc(100% - 36px));margin:auto}nav{height:72px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{font-weight:950;text-decoration:none;font-size:20px;letter-spacing:-.02em}.brand:before{content:"▰";color:var(--forest);margin-right:9px}.links{display:flex;gap:4px}.links a{padding:8px 10px;text-decoration:none;font-size:14px}.links .join{background:var(--forest);color:#fff;border-radius:8px}.hero{padding:68px 0 48px;display:grid;min-width:0;grid-template-columns:.78fr 1.22fr;gap:34px;align-items:center}.eyebrow{font:800 12px ui-monospace,monospace;color:var(--forest);text-transform:uppercase;letter-spacing:.12em}h1{font-size:clamp(54px,7.5vw,94px);letter-spacing:-.065em;line-height:.9;margin:17px 0 20px}.lead{font-size:18px;color:var(--muted)}.actions{display:flex;gap:9px;flex-wrap:wrap;margin:25px 0 15px}.btn{display:inline-flex;padding:12px 15px;border:1px solid #869287;border-radius:8px;text-decoration:none;font-weight:850;background:rgba(255,255,255,.3)}.btn.primary{background:var(--forest);border-color:var(--forest);color:#fff}.addr{display:inline-flex;gap:8px;align-items:center;border-bottom:2px solid var(--forest);padding:5px 0;font:750 13px ui-monospace,monospace}.copy{border:0;background:transparent;color:var(--forest);font:inherit;font-weight:900;cursor:pointer}.mapcard{position:relative;min-height:510px;border:1px solid #7d897f;border-radius:6px;overflow:hidden;background:#102018;box-shadow:12px 12px 0 rgba(35,77,53,.16)}.mapcard img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.mapcard:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(8,18,11,.85))}.mapmeta{position:absolute;z-index:2;left:22px;right:22px;bottom:20px;color:#fff;display:flex;justify-content:space-between;gap:20px;align-items:end}.mapmeta b{font-size:20px}.mapmeta span{color:#d4e2d6;font-size:13px}.index{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);background:var(--card);margin:10px 0 86px}.index div{padding:16px;border-right:1px solid var(--line)}.index div:last-child{border-right:0}.index b{display:block;font-size:16px}.index span{color:var(--muted);font-size:13px}.section{padding:0 0 90px}.section-head{display:grid;grid-template-columns:.8fr 1.2fr;gap:35px;margin-bottom:25px}.section h2{font-size:clamp(35px,4.5vw,54px);line-height:1;letter-spacing:-.04em;margin:0}.section-head p{color:var(--muted);margin:0;max-width:660px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:1px solid var(--line);background:rgba(244,241,231,.8);padding:21px;border-radius:6px}.card .tag{font:800 11px ui-monospace,monospace;color:var(--forest)}.card h3{margin:8px 0;font-size:21px}.card p{margin:0;color:var(--muted);font-size:14px}.illustrated{padding:0;overflow:hidden}.illustrated img{width:100%;height:210px;object-fit:cover;display:block}.illustrated .body{padding:20px}.notice{border-left:5px solid var(--forest);background:#f2efe5;padding:17px 20px;margin-bottom:18px;color:var(--muted)}.notice strong{color:var(--ink)}.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:9px}.step{border-top:4px solid var(--forest);background:rgba(244,241,231,.82);padding:18px;min-height:200px}.step .n{font:800 12px ui-monospace,monospace;color:var(--forest)}.step h3{margin:12px 0 6px}.step p{margin:0;color:var(--muted);font-size:13px}.step a{color:var(--forest);font-weight:800}.downloads{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:10px}.download{border:1px solid var(--line);background:var(--card);padding:22px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between}.download.main{background:var(--forest);color:#fff}.download small{font:900 11px ui-monospace,monospace;text-transform:uppercase}.download h3{font-size:24px;margin:8px 0}.download p{font-size:14px;color:var(--muted)}.download.main p{color:#d5e1d8}.download.main .btn{border-color:#fff;color:#fff}.faq{display:grid;grid-template-columns:1fr 1fr;gap:9px}.faq article{border-bottom:1px solid var(--line);padding:16px 0}.faq h3{margin:0 0 5px}.faq p{margin:0;color:var(--muted);font-size:14px}.faq a{color:var(--forest)}footer{border-top:1px solid var(--line);padding:25px 0 40px;color:var(--muted);font-size:13px}.foot{display:flex;justify-content:space-between;gap:15px}.foot a{text-decoration:none}
@media(max-width:900px){.hero,.section-head{grid-template-columns:1fr}.mapcard{min-height:430px}.links a:not(.join){display:none}.cards{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr}.downloads{grid-template-columns:1fr}.index{grid-template-columns:1fr 1fr}}@media(max-width:600px){.wrap{width:min(calc(100% - 24px),1180px)}.links{display:none}.hero>*{min-width:0}h1{font-size:50px;max-width:100%}.mapcard{min-height:330px}.cards,.steps,.faq,.index{grid-template-columns:1fr}.index div{border-right:0;border-bottom:1px solid var(--line)}.section{padding-bottom:64px}.foot{display:block}.foot div+div{margin-top:8px}}
</style></head><body><div class="wrap"><nav><a class="brand" href="#top">${SERVER_NAME}</a><div class="links"><a href="#world">Обзор</a><a href="#start">Старт</a><a href="#download">Лаунчер</a><a href="${MAP_URL}">Карта</a><a class="join" href="${AUTH_BASE_URL}/web/registration">Регистрация</a></div></nav>
<main id="top"><section class="hero"><div><div class="eyebrow">Minecraft Java ${MC_VERSION} / ${OWNERSHIP_MODE_LABEL}</div><h1>Карта мира начинается здесь.</h1><p class="lead">${OWNERSHIP_LEAD}</p><div class="actions"><a class="btn primary" href="${AUTH_BASE_URL}/web/registration">Создать аккаунт</a><a class="btn" href="#download">Скачать лаунчер</a></div><div class="addr">${MC_ADDRESS} <button class="copy" data-copy="${MC_ADDRESS}">копировать</button></div></div><a class="mapcard" href="${MAP_URL}"><img src="/assets/bluemap.webp" alt="BlueMap мира"><div class="mapmeta"><div><span>Живая карта сервера</span><br><b>${SERVER_NAME}</b></div><b>Открыть ↗</b></div></a></section>
<div class="index"><div><b>130+ структур</b><span>башни, руины, дома, подземелья</span></div><div><b>Overworld</b><span>Terralith + Tectonic</span></div><div><b>Nether / End</b><span>Incendium + Nullscape</span></div><div><b>Vanilla client</b><span>без обязательных модов</span></div></div>
<section class="section" id="world"><div class="section-head"><h2>Мир важнее интерфейса.</h2><p>Поэтому этот шаблон строится вокруг карты и крупных иллюстраций. Он показывает не «панель управления сервером», а место, куда игрок собирается прийти.</p></div><div class="cards"><article class="card illustrated"><img src="/assets/voxel-world.webp" alt="Voxel-мир"><div class="body"><div class="tag">SURVIVAL</div><h3>Больше мира</h3><p>Расширенная генерация и структуры работают на стороне сервера.</p></div></article><article class="card illustrated"><img src="/assets/isometric-world.webp" alt="Изометрический мир"><div class="body"><div class="tag">EXPLORE</div><h3>Есть куда идти</h3><p>Новые точки интереса в трёх измерениях без отдельного клиентского modpack.</p></div></article><article class="card"><div class="tag">CLIENT</div><h3>Обычная Java Edition</h3><p>Minecraft ${MC_VERSION}; Fabric/Forge/NeoForge игроку не нужны. MyMine Launcher уже знает адрес сервера и авторизации.</p></article></div></section>
<section class="section" id="start"><div class="section-head"><h2>Как подключиться.</h2><p>Пять коротких шагов вместо инструкции на несколько экранов.</p></div><div class="notice"><strong>${OWNERSHIP_NOTICE_TITLE}</strong><br>${OWNERSHIP_NOTICE_TEXT}</div><div class="steps"><article class="step"><div class="n">01</div><h3>Регистрация</h3><p>${OWNERSHIP_STEP_TEXT} <a href="${AUTH_BASE_URL}/web/registration">Открыть →</a></p></article><article class="step"><div class="n">02</div><h3>Лаунчер</h3><p>Скачай MyMine Launcher.</p></article><article class="step"><div class="n">03</div><h3>Вход</h3><p>Добавь аккаунт MyMine.</p></article><article class="step"><div class="n">04</div><h3>${MC_VERSION}</h3><p>Установи обычную Java Edition.</p></article><article class="step"><div class="n">05</div><h3>Играй</h3><p><button class="copy" data-copy="${MC_ADDRESS}">${MC_ADDRESS}</button></p></article></div></section>
<section class="section" id="download"><div class="section-head"><h2>MyMine Launcher.</h2><p>Сборка HMCL ${HMCL_VERSION} с параметрами именно этого экземпляра MyMine.</p></div><div class="downloads"><article class="download main"><div><small>Windows</small><h3>Launcher.exe</h3><p>Скачал, добавил аккаунт, запустил игру.</p></div><a class="btn" href="/downloads/MyMineLauncher-${HMCL_VERSION}.exe" download>Скачать EXE</a></article><article class="download"><div><small>Linux</small><h3>DEB</h3><p>Debian, Ubuntu, Mint.</p></div><a class="btn" href="/downloads/MyMineLauncher-${HMCL_VERSION}.deb" download>Скачать DEB</a></article><article class="download"><div><small>Universal</small><h3>JAR</h3><p>Для системы с Java.</p></div><a class="btn" href="/downloads/MyMineLauncher-${HMCL_VERSION}.jar" download>Скачать JAR</a></article></div></section>
<section class="section"><div class="section-head"><h2>Короткие ответы.</h2><p>То, что чаще всего нужно знать до первого запуска.</p></div><div class="faq"><article><h3>Нужен Microsoft-аккаунт?</h3><p>${OWNERSHIP_FAQ}</p></article><article><h3>Нужны моды?</h3><p>Нет, базовая сборка рассчитана на обычный Minecraft Java ${MC_VERSION}.</p></article><article><h3>Где карта?</h3><p><a href="${MAP_URL}">BlueMap →</a></p></article><article><h3>Исходники лаунчера?</h3><p><a href="/downloads/MyMineLauncher-${HMCL_VERSION}-source.tar.gz">Здесь</a>; контрольные суммы — <a href="/downloads/SHA256SUMS">SHA256SUMS</a>.</p></article></div></section></main></div>
<footer><div class="wrap foot"><div>${SERVER_NAME} · Minecraft ${MC_VERSION}</div><div><a href="${MAP_URL}">Карта</a> · <a href="${AUTH_BASE_URL}/">Личный кабинет</a> · <a href="/assets/ATTRIBUTION.txt">Иллюстрации</a></div></div></footer><script>document.querySelectorAll('[data-copy]').forEach(function(b){b.addEventListener('click',function(){var t=b.getAttribute('data-copy');if(navigator.clipboard)navigator.clipboard.writeText(t);var o=b.textContent;b.textContent='скопировано';setTimeout(function(){b.textContent=o},1300)})});</script></body></html>
